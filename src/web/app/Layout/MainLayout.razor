@inherits LayoutComponentBase
@inject ICarrinhoPedidoService CarrinhoPedidoService
@inject ICarrinhoPersistenciaLocalService CarrinhoPersistenciaLocalService
@implements IDisposable

<div class="app-shell">
    <div class="app-frame">
        <aside class="app-sidebar">
            <NavMenu />
        </aside>

        <main class="app-main">
            <header class="app-topbar">
                <div>
                    <div class="eyebrow">PWA mobile-first</div>
                    <strong>Comanda digital local para bares e restaurantes</strong>
                </div>
                <div class="topbar-meta">
                    <span class="cart-pill">Carrinho @CarrinhoPedidoService.QuantidadeTotalItens</span>
                    <span class="version-pill">0.0.1</span>
                </div>
            </header>

            <article class="app-content">
                @Body
            </article>
        </main>
    </div>
</div>

@code {
    private bool carrinhoCarregado;
    private bool restaurandoCarrinho;

	protected override void OnInitialized()
	{
		CarrinhoPedidoService.Changed += OnCarrinhoChanged;
	}

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        restaurandoCarrinho = true;
        var itensSalvos = await CarrinhoPersistenciaLocalService.CarregarAsync();

        if (itensSalvos.Count > 0)
        {
            CarrinhoPedidoService.SubstituirItens(itensSalvos);
        }

        restaurandoCarrinho = false;
        carrinhoCarregado = true;
        StateHasChanged();
    }

	private void OnCarrinhoChanged()
	{
        _ = InvokeAsync(async () =>
        {
            if (carrinhoCarregado && !restaurandoCarrinho)
            {
                await CarrinhoPersistenciaLocalService.SalvarAsync(CarrinhoPedidoService.Itens);
            }

            StateHasChanged();
        });
	}

	public void Dispose()
	{
		CarrinhoPedidoService.Changed -= OnCarrinhoChanged;
	}
}
